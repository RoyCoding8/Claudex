# Claudex environment configuration.
#
# Copy this file to `.env` (next to this one, in the project root) and edit it.
# The launcher and the router both read it at startup. Lines here are just
# examples — every value is commented out, so Claudex uses its built-in
# defaults until you uncomment a line.
#
# Real provider credentials live in CLIProxyAPI's config.yaml, NEVER here.
# These values only configure local traffic between Claude Code, the cx
# router, and CLIProxyAPI.
#
# Rules:
#   - A value already present in the real environment (shell export / launcher)
#     always wins over this file.
#   - Empty or unset values fall back to the built-in defaults shown below.

# --- cx router ---------------------------------------------------------------
# Where the router listens and the local key it expects from Claude Code.
# CX_ROUTER_HOST=127.0.0.1
# CX_ROUTER_PORT=4000
# CX_ROUTER_API_KEY=sk-cx-local

# Cooldown durations (seconds, clamped to 1-1800) applied when a pool member
# fails. 429 honors the upstream Retry-After when present.
# CX_ROUTER_COOLDOWN_429=60          # fallback 429 cooldown when no Retry-After
# CX_ROUTER_COOLDOWN_5XX=30
# CX_ROUTER_COOLDOWN_NETWORK=10
# CX_ROUTER_COOLDOWN_AUTH=300
# CX_ROUTER_COOLDOWN_PACED_429=10     # 429 on a member with an rpm/limit cap, no Retry-After
# CX_ROUTER_COOLDOWN_EMPTY=20         # member answered 200 with no usable content

# Whole-request budget for a pooled call, shared by every failover attempt
# (seconds). Raise it for large pools or slow providers.
# CX_ROUTER_POOL_TIMEOUT=180

# Sweeps over the member list before a pool gives up. Capacity-limited providers
# reject transiently, so a second sweep recovers most of them.
# CX_ROUTER_POOL_PASSES=2

# Startup grace period for the router to answer /health (seconds).
# CX_ROUTER_START_TIMEOUT=35

# --- CLIProxyAPI -------------------------------------------------------------
# Location of the CLIProxyAPI executable and its config. Relative paths
# resolve against the project root; absolute paths work too.
# CX_CLIPROXY_EXE=cli-proxy-api.exe
# CX_CLIPROXY_CONFIG=config.yaml

# Where CLIProxyAPI listens and the local key the router uses to reach it.
# CX_CLIPROXY_HOST=127.0.0.1
# CX_CLIPROXY_PORT=8317
# CX_CLIPROXY_API_KEY=sk-dummy

# Startup grace period for CLIProxyAPI (seconds).
# CX_CLIPROXY_START_TIMEOUT=15

# --- model role defaults -----------------------------------------------------
# Optional pool/model IDs used as defaults for the F6 "model roles" picker
# before you set them interactively. Leave blank to use the picker only.
# CX_GPT_FAST_MODEL=
# CX_GPT_MEDIUM_MODEL=
# CX_GPT_SUBAGENT_MODEL=
# CX_DEFAULT_COMPACT_WINDOW=170000
